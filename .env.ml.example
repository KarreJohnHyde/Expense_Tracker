# Machine Learning Configuration

# ──────────────────────────────────────────────────────────────
# TensorFlow.js Configuration
# ──────────────────────────────────────────────────────────────

# Auto-initialize ML models on app startup
VITE_ML_AUTO_INITIALIZE=true

# Base path for saved models in browser storage
VITE_ML_MODEL_PATH=expense_ml_v1

# Enable offline mode (works without server)
VITE_ML_OFFLINE_MODE=true

# ──────────────────────────────────────────────────────────────
# Lambda Configuration (Optional - for advanced NLP)
# ──────────────────────────────────────────────────────────────

# AWS Lambda endpoint for advanced ML processing
VITE_USE_LAMBDA_ML=false
AWS_LAMBDA_URL=https://your-lambda-url.lambda-url.region.on.aws

# API key for Lambda (if required)
AWS_LAMBDA_API_KEY=your-api-key-here

# ──────────────────────────────────────────────────────────────
# Model Training Configuration
# ──────────────────────────────────────────────────────────────

# Number of epochs for model training
VITE_ML_EPOCHS=30

# Batch size during training
VITE_ML_BATCH_SIZE=32

# Validation split ratio
VITE_ML_VALIDATION_SPLIT=0.2

# ──────────────────────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────────────────────

# Enable category prediction
VITE_ML_ENABLE_CLASSIFIER=true

# Enable spending forecasting
VITE_ML_ENABLE_PREDICTOR=true

# Enable anomaly detection
VITE_ML_ENABLE_DETECTOR=true

# Enable ML demo page at /ml-demo
VITE_ML_ENABLE_DEMO_PAGE=true

# ──────────────────────────────────────────────────────────────
# Performance Tuning
# ──────────────────────────────────────────────────────────────

# Use WebGL backend for better performance (if available)
VITE_TF_BACKEND=webgl

# Enable TensorFlow.js logging
VITE_TF_DEBUG=false

# Memory limit for models (in MB)
VITE_TF_MAX_MEMORY=512

# ──────────────────────────────────────────────────────────────
# Supabase Edge Functions
# ──────────────────────────────────────────────────────────────

# Enable server-side ML processing
VITE_USE_SUPABASE_ML=false

# Supabase project reference
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ──────────────────────────────────────────────────────────────
# Production Deployment
# ──────────────────────────────────────────────────────────────

# Compress models for deployment
VITE_ML_COMPRESS_MODELS=true

# Cache models aggressively
VITE_ML_CACHE_MODELS=true

# Enable analytics on model performance
VITE_ML_ANALYTICS=false
